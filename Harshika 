import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
# Create sample mental health survey data
data = {
 'Student': ['S1', 'S2', 'S3', 'S4', 'S5',
 'S6', 'S7', 'S8', 'S9', 'S10'],
 'Sleep_Hours': [8, 5, 6, 4, 7, 5, 8, 4, 6, 5],
 'Study_Hours': [3, 8, 6, 10, 4, 9, 3, 10, 6, 8],
 'Stress_Level': [2, 8, 5, 9, 3, 7, 2, 10, 6, 8]
}
df = pd.DataFrame(data)
# Display survey data
print("MENTAL HEALTH SURVEY DATA")
print(df.to_string(index=False))
# Calculate average values
print("\nAVERAGE VALUES")
print("Average Sleep Hours:",
 df['Sleep_Hours'].mean())
print("Average Study Hours:",
 df['Study_Hours'].mean())
print("Average Stress Level:", df['Stress_Level'].mean())
# Identify stress patterns
print("\nSTRESS ANALYSIS")
print("High stress responses (level >= 7):",
 (df['Stress_Level'] >= 7).sum())
# Correlation analysis
print("\nCORRELATION MATRIX")
print(df[['Sleep_Hours', 'Study_Hours',
 'Stress_Level']].corr().round(2))
# Visualize stress levels
plt.figure(figsize=(8, 5))
sns.barplot(data=df, x='Student',
 y='Stress_Level')
plt.title('Stress Level of Survey Participants')
plt.xlabel('Student')
plt.ylabel('Stress Level (0-10)')
plt.tight_layout()
plt.show()
# Compare sleep hours and stress
plt.figure(figsize=(8, 5))
sns.regplot(data=df, x='Sleep_Hours',
 y='Stress_Level')
plt.title('Sleep Hours vs Stress Level')
plt.xlabel('Sleep Hours')
plt.ylabel('Stress Level (0-10)')
plt.tight_layout() plt.show()
# Compare study hours and stress
plt.figure(figsize=(8, 5))
sns.regplot(data=df, x='Study_Hours',
 y='Stress_Level')
plt.title('Study Hours vs Stress Level')
plt.xlabel('Study Hours')
plt.ylabel('Stress Level (0-10)')
plt.tight_layout()
plt.show()
